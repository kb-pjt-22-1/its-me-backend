<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="site.benepay.domain.merchant.mapper.MerchantCategoryMapper">

    <select id="findAll" resultType="site.benepay.domain.merchant.vo.MerchantCategory">
        SELECT category_code, category_name, category_icon
        FROM merchant_categories
        ORDER BY category_code
    </select>

</mapper>
