<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="site.benepay.domain.merchant.mapper.MerchantMapper">

    <sql id="merchantColumns">
        merchant_id
        , brand_id, category_code, merchant_code, merchant_name, address, latitude, longitude, phone
    </sql>

    <select id="findAll" resultType="site.benepay.domain.merchant.vo.Merchant">
        SELECT
        <include refid="merchantColumns"/>
        FROM merchants
        <where>
            <if test="categoryCode != null">
                category_code = #{categoryCode}
            </if>
        </where>
        ORDER BY merchant_id DESC
    </select>

    <!-- 매장 상세(핀 클릭) 조회 -->
    <select id="findByMerchantId" resultType="site.benepay.domain.merchant.vo.Merchant">
        SELECT
        <include refid="merchantColumns"/>
        FROM merchants
        WHERE merchant_id = #{merchantId}
    </select>

    <!-- 지도 화면(bounds) 사각형 범위 안의 매장만 반환 -->
    <select id="findWithinBounds" resultType="site.benepay.domain.merchant.vo.Merchant">
        SELECT
        <include refid="merchantColumns"/>
        FROM merchants
        WHERE latitude BETWEEN #{swLat} AND #{neLat}
        AND longitude BETWEEN #{swLng} AND #{neLng}
        <if test="categoryCode != null">
            AND category_code = #{categoryCode}
        </if>
    </select>

    <!-- 홈 화면 "오늘의 추천" 후보 조회. Haversine 공식으로 사용자 위치(lat/lng)에서 각 매장까지의
         실거리(m)를 계산해 가까운 순으로 limit개만 뽑는다 - 혜택 판단(benefitAvailable)은 이후
         Facade가 하므로 여기선 필터링 없이 거리순 후보만 넉넉히 확보한다. COS 인자를 LEAST/GREATEST로
         [-1, 1]에 clamp하는 이유: 부동소수점 오차로 인자가 1을 살짝 넘으면 ACOS가 NULL을 반환해
         (실제로 같은 좌표의 매장에서 재현됨) 그 매장의 거리가 NULL이 되어 정렬이 깨진다. -->
    <select id="findNearby" resultType="site.benepay.domain.merchant.vo.NearbyMerchantVO">
        SELECT
        <include refid="merchantColumns"/>
        , (6371000 * ACOS(
            LEAST(1, GREATEST(-1,
                COS(RADIANS(#{lat})) * COS(RADIANS(latitude)) * COS(RADIANS(longitude) - RADIANS(#{lng}))
                + SIN(RADIANS(#{lat})) * SIN(RADIANS(latitude))
            ))
        )) AS distance_meters
        FROM merchants
        <where>
            <if test="categoryCode != null">
                category_code = #{categoryCode}
            </if>
        </where>
        ORDER BY distance_meters ASC
        LIMIT #{limit}
    </select>

</mapper>
