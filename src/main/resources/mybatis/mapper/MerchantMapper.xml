<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="site.benepay.domain.merchant.mapper.MerchantMapper">

    <sql id="merchantColumns">
        merchant_id
        , brand_id, category_code, merchant_code, merchant_name, address, latitude, longitude
    </sql>

    <select id="findAll" resultType="site.benepay.domain.merchant.vo.Merchant">
        SELECT
        <include refid="merchantColumns"/>
        FROM merchants
        <where>
            <if test="categoryCode != null">
                category_code = #{categoryCode}
            </if>
        </where>
        ORDER BY merchant_id DESC
    </select>

    <!-- 매장 상세(핀 클릭) 조회 -->
    <select id="findByMerchantId" resultType="site.benepay.domain.merchant.vo.Merchant">
        SELECT
        <include refid="merchantColumns"/>
        FROM merchants
        WHERE merchant_id = #{merchantId}
    </select>

    <!-- Redis GEO 검색이 추려낸 merchantId들의 상세 정보 일괄 조회 (PK IN 조회라 순서는 보장 안 함) -->
    <select id="findByIds" resultType="site.benepay.domain.merchant.vo.Merchant">
        SELECT
        <include refid="merchantColumns"/>
        FROM merchants
        WHERE merchant_id IN
        <foreach item="merchantId" collection="merchantIds" open="(" separator="," close=")">
            #{merchantId}
        </foreach>
    </select>

</mapper>
