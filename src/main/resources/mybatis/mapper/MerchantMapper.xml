<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="site.benepay.domain.merchant.mapper.MerchantMapper">

    <sql id="merchantColumns">
        merchant_id
        , brand_id, category_code, merchant_code, merchant_name, address, latitude, longitude, phone
    </sql>

    <select id="findAll" resultType="site.benepay.domain.merchant.vo.Merchant">
        SELECT
        <include refid="merchantColumns"/>
        FROM merchants
        <where>
            <if test="categoryCode != null">
                category_code = #{categoryCode}
            </if>
        </where>
        ORDER BY merchant_id DESC
    </select>

    <!-- 매장 상세(핀 클릭) 조회 -->
    <select id="findByMerchantId" resultType="site.benepay.domain.merchant.vo.Merchant">
        SELECT
        <include refid="merchantColumns"/>
        FROM merchants
        WHERE merchant_id = #{merchantId}
    </select>

    <!-- Redis GEO 검색(MerchantGeoSyncScheduler/MerchantServiceImpl 참고)이 뽑아준 merchant_id
         목록으로 나머지 컬럼을 채운다. 거리 계산·정렬·limit은 전부 Redis 쪽에서 이미 끝났다. -->
    <select id="findByIds" resultType="site.benepay.domain.merchant.vo.Merchant">
        SELECT
        <include refid="merchantColumns"/>
        FROM merchants
        WHERE merchant_id IN
        <foreach collection="merchantIds" item="merchantId" open="(" separator="," close=")">
            #{merchantId}
        </foreach>
    </select>

</mapper>
